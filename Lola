<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Para Lola</title>

<style>
body {
    margin: 0;
    height: 100vh;
    background: #fdfaf7;
    font-family: 'Arial', sans-serif;
    color: #5a4a4a;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.contenedor {
    max-width: 600px;
    padding: 40px 20px;
}

h1 {
    font-size: 2.2em;
    font-weight: normal;
    margin-bottom: 20px;
}

.carta {
    font-size: 1.25em;
    line-height: 1.7;
    min-height: 120px;
}

.contador {
    margin-top: 30px;
    font-size: 1.1em;
    color: #a38b8b;
}

button {
    margin-top: 30px;
    padding: 8px 18px;
    font-size: 0.95em;
    background: transparent;
    border: 1px solid #c9b6b6;
    border-radius: 20px;
    color: #5a4a4a;
    cursor: pointer;
}

.sorpresa {
    margin-top: 20px;
    font-size: 1.15em;
    opacity: 0;
    transition: opacity 1s;
}

/* Reproductor oculto */
#musica {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
}
</style>
</head>

<body onclick="activarMusica()">

<div class="contenedor">
    <h1>Para ti, Lola</h1>

    <div class="carta" id="carta"></div>

    <div class="contador" id="contador"></div>

    <button onclick="mostrarSorpresa()">Un poquito más</button>

    <div class="sorpresa" id="sorpresa">
        Contigo, la vida se siente más tranquila,<br>
        más bonita…<br>
        más hogar.
    </div>
</div>

<!-- 🎶 Música desde YouTube (oculta) -->
<iframe
    id="musica"
    src="https://www.youtube.com/embed/eLMwfHBx7fc?enablejsapi=1"
    frameborder="0"
    allow="autoplay"
></iframe>

<script>
/* ✍️ TEXTO QUE SE ESCRIBE SOLO */
const texto =
`Entre más tiempo paso a tu lado,
más te amo…
y más me quiero quedar.

Gracias por hacer de lo simple
algo tan bonito.`;

let i = 0;
function escribir() {
    if (i < texto.length) {
        document.getElementById("carta").innerHTML += texto.charAt(i);
        i++;
        setTimeout(escribir, 55);
    }
}
escribir();

/* ⏳ CONTADOR */
const inicio = new Date();
inicio.setDate(inicio.getDate() - 282);

function actualizar() {
    const ahora = new Date();
    const diff = ahora - inicio;

    const d = Math.floor(diff / (1000 * 60 * 60 * 24));
    const h = Math.floor((diff / (1000 * 60 * 60)) % 24);
    const m = Math.floor((diff / (1000 * 60)) % 60);
    const s = Math.floor((diff / 1000) % 60);

    document.getElementById("contador").textContent =
        `Nuestra historia lleva ${d} días ${h}h ${m}m ${s}s`;
}
setInterval(actualizar, 1000);
actualizar();

/* 💌 SORPRESA */
function mostrarSorpresa() {
    document.getElementById("sorpresa").style.opacity = 1;
}

/* 🎶 ACTIVAR MÚSICA AL TOCAR LA PÁGINA */
let musicaActiva = false;

function activarMusica() {
    if (!musicaActiva) {
        const iframe = document.getElementById("musica");
        iframe.src += "&autoplay=1&mute=0";
        musicaActiva = true;
    }
}
</script>

</body>
</html>
